  "contact": {
    "sources": "https://github.com/davidverthum/luma-launcher"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["gg.luma.cosmetics.LumaCosmetics"],
    "client": ["gg.luma.cosmetics.client.LumaCosmeticsClient"]
  },
  "mixins": ["luma-cosmetics.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "bluemap": "*"
  }
