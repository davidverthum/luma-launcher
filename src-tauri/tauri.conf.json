{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "0.1.1",
  "identifier": "gg.luma.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Luma",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4NjNDMjBCMDI5NTBDODUKUldTRkRKVUNDOEpqdU12dlc1ckM0Tk83b2ZKa0V5d1VpNkV3Q0JtUlVhVkZzblhBMjd1S2QzWmsK",
      "endpoints": ["https://github.com/davidverthum/luma-launcher/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Лаунчер сети Minecraft-серверов Luma",
    "longDescription": "Luma — лаунчер сети Minecraft-серверов: пять миров, у каждого свой свет, друзья и пати до запуска.",
    "copyright": "© 2026 Luma",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "headerImage": "icons/installer/header.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
